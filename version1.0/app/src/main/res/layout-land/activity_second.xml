<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/background_landscape">

    <TextView
        android:id="@+id/textViewHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/activity2_title"
        android:textSize="20sp"
        android:textColor="@color/accent_color"
        android:textStyle="bold"
        android:fontFamily="cursive"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp"/>

    <!-- Left side: Book Details -->
    <TextView
        android:id="@+id/labelTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_title"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:textColor="@color/primary_text"
        app:layout_constraintTop_toBottomOf="@id/textViewHeader"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"/>

    <TextView
        android:id="@+id/textViewTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Book Title"
        android:textSize="16sp"
        android:fontFamily="sans-serif-light"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/labelTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/imageViewPhoto"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"/>

    <TextView
        android:id="@+id/labelAuthor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_author"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:textColor="@color/primary_text"
        app:layout_constraintTop_toBottomOf="@id/textViewTitle"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="12dp"/>

    <TextView
        android:id="@+id/textViewAuthor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Author Name"
        android:textSize="16sp"
        android:fontFamily="sans-serif-light"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/labelAuthor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/imageViewPhoto"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"/>

    <TextView
        android:id="@+id/labelYear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_year"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:textColor="@color/primary_text"
        app:layout_constraintTop_toBottomOf="@id/textViewAuthor"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="12dp"/>

    <TextView
        android:id="@+id/textViewYear"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Year"
        android:textSize="16sp"
        android:fontFamily="sans-serif-light"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/labelYear"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/imageViewPhoto"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"/>

    <!-- Right side: Image -->
    <ImageView
        android:id="@+id/imageViewPhoto"
        android:layout_width="180dp"
        android:layout_height="0dp"
        android:background="@drawable/book_landscape"
        android:scaleType="centerCrop"
        android:contentDescription="Book Photo"
        app:layout_constraintTop_toBottomOf="@id/textViewHeader"
        app:layout_constraintBottom_toTopOf="@id/btnTakePhoto"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"/>

    <!-- Buttons at bottom -->
    <Button
        android:id="@+id/btnTakePhoto"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="@string/btn_take_photo"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:backgroundTint="@color/accent_color"
        android:textColor="@color/white"
        app:layout_constraintBottom_toTopOf="@id/btnNext"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnNext"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="@string/btn_next"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:backgroundTint="@color/button_color"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>